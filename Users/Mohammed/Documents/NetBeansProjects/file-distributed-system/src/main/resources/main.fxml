<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.file.distributed.system.ui.FileClientController"
            styleClass="root-pane"
            prefWidth="1000" prefHeight="680">

    <!-- top stuff -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>

            <Label text="📂" styleClass="header-icon"/>
            <Label text="File Distributed System" styleClass="header-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="statusDot" text="●" style="-fx-text-fill: #f87171; -fx-font-size: 16px;"/>
            <Label fx:id="statusLabel" text="Disconnected" styleClass="status-text"/>
        </HBox>
    </top>

    <!-- left stuff -->
    <left>
        <VBox styleClass="left-panel" spacing="10" minWidth="200" maxWidth="220">
            <padding><Insets top="24" right="16" bottom="24" left="16"/></padding>

            <!-- server box -->
            <Label text="SERVER" styleClass="section-label"/>

            <TextField fx:id="hostField"
                       promptText="Host (localhost)"
                       styleClass="field"
                       text="localhost"/>

            <TextField fx:id="portField"
                       promptText="Port (9090)"
                       styleClass="field"
                       text="9090"/>

            <Button fx:id="connectBtn"
                    text="Connect"
                    styleClass="btn-connect"
                    maxWidth="Infinity"
                    onAction="#handleConnect"/>

            <Separator styleClass="divider"/>

            <!-- button box -->
            <Label text="ACTIONS" styleClass="section-label"/>

            <Button fx:id="listBtn"
                    text="📋  List Files"
                    styleClass="btn-action"
                    maxWidth="Infinity"
                    disable="true"
                    onAction="#handleList"/>

            <Button fx:id="uploadBtn"
                    text="⬆  Upload File"
                    styleClass="btn-action"
                    maxWidth="Infinity"
                    disable="true"
                    onAction="#handleUpload"/>

            <Button fx:id="downloadBtn"
                    text="⬇  Download File"
                    styleClass="btn-action"
                    maxWidth="Infinity"
                    disable="true"
                    onAction="#handleDownload"/>

            <Button fx:id="deleteBtn"
                    text="🗑  Delete File"
                    styleClass="btn-danger"
                    maxWidth="Infinity"
                    disable="true"
                    onAction="#handleDelete"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Double-click a file to download it."
                   styleClass="hint-label"
                   wrapText="true"/>
        </VBox>
    </left>

    <!-- middle stuff -->
    <center>
        <VBox styleClass="center-panel" spacing="12">
            <padding><Insets top="24" right="24" bottom="0" left="24"/></padding>

            <Label text="Server Files" styleClass="panel-title"/>

            <TableView fx:id="fileTable" VBox.vgrow="ALWAYS" styleClass="file-table">
                <columns>
                    <TableColumn fx:id="nameColumn" text="File Name"
                                 prefWidth="340" minWidth="180"/>
                    <TableColumn fx:id="sizeColumn" text="Size"
                                 prefWidth="120" minWidth="80"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <!-- bottom stuff -->
    <bottom>
        <VBox styleClass="bottom-panel" spacing="6">
            <padding><Insets top="10" right="24" bottom="16" left="24"/></padding>

            <!-- bar move -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Progress:" styleClass="section-label"/>
                <ProgressBar fx:id="progressBar"
                             progress="0"
                             HBox.hgrow="ALWAYS"
                             maxWidth="Infinity"
                             styleClass="progress"/>
                <Label fx:id="progressLabel" text="" styleClass="progress-label" minWidth="42"/>
            </HBox>

            <!-- log talk -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Console" styleClass="section-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Clear"
                        styleClass="btn-mini"
                        onAction="#handleClearLog"
                        fx:id="clearLogBtn"/>
            </HBox>

            <TextArea fx:id="logArea"
                      editable="false"
                      wrapText="true"
                      prefHeight="140"
                      styleClass="console"/>
        </VBox>
    </bottom>

</BorderPane>
